# Environment and public URLs
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database & Cache
DATABASE_URL=postgresql://pinnacle:stride_secret@localhost:5432/pinnaclestride?schema=public
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_BUCKET=pinnacle-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth & Security
JWT_ACCESS_SECRET=pinnaclestride_development_jwt_access_secret_key_32chars_min!
JWT_REFRESH_SECRET=pinnaclestride_development_jwt_refresh_secret_key_32chars_min!
COOKIE_SECRET=pinnaclestride_cookie_secret_key_for_session_management!
TOTP_ENCRYPTION_KEY=totp_super_secret_encryption_key_32chars!
ALTCHA_HMAC_KEY=altcha_proof_of_work_secret_hmac_key_pinnaclestride

# Email (SMTP / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hello@pinnaclestride.com
TEAM_NOTIFY_EMAIL=inquiries@pinnaclestride.com

# Cache & Revalidation
REVALIDATE_SECRET=on_demand_revalidation_secret_token_123

# Observability (Optional)
UMAMI_WEBSITE_ID=
GLITCHTIP_DSN=

# First-run Admin Seeding
INITIAL_OWNER_EMAIL=admin@pinnaclestride.com
INITIAL_OWNER_PASSWORD=PinnacleStride2026!Admin
